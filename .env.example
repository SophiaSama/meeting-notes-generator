# ── LLM provider (any OpenAI-compatible API) ──────────────────────────────────
# Falls back to OPENAI_BASE_URL / OPENAI_API_KEY when the LLM_* values are unset.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
#
# Provider examples (base URL / model):
#   OpenAI         https://api.openai.com/v1                     gpt-4o-mini
#   OpenRouter     https://openrouter.ai/api/v1                  anthropic/claude-sonnet-4
#   Groq           https://api.groq.com/openai/v1                llama-3.3-70b-versatile
#   DeepSeek       https://api.deepseek.com/v1                   deepseek-chat
#   Moonshot       https://api.moonshot.ai/v1                    kimi-k2-0711-preview
#   Gemini         https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.5-flash
#   Ollama (local) http://localhost:11434/v1                     llama3.1   (any non-empty API key)
#   LM Studio      http://localhost:1234/v1                      <loaded model id>
#   vLLM / LiteLLM http://localhost:8000/v1                      <served model id>

# Optional extra HTTP headers sent on every request (JSON object), e.g. for OpenRouter:
# LLM_EXTRA_HEADERS={"HTTP-Referer": "https://github.com/you/meeting-notes-helper", "X-Title": "Meeting Notes Helper"}

# ── Audio transcription (/audio/transcriptions) ───────────────────────────────
# Not every provider offers this endpoint. Point transcription at a provider
# that does (e.g. OpenAI or Groq) while chat uses another one.
LLM_TRANSCRIBE_MODEL=gpt-4o-transcribe
# LLM_TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# LLM_TRANSCRIBE_API_KEY=gsk-your-groq-key
# (with Groq use LLM_TRANSCRIBE_MODEL=whisper-large-v3-turbo)

# Optional vision model for on-screen text OCR of screenshots (disabled when unset)
# LLM_OCR_MODEL=gpt-4o-mini

# ── Long-transcript and reasoning-model controls ──────────────────────────────
LLM_NOTES_MAP_REDUCE_TRIGGER_CHARS=28000
LLM_NOTES_MAP_REDUCE_SEGMENT_CHARS=12000
# Uses the OpenAI Batch API (/files + /batches); most other providers don't support it.
LLM_NOTES_USE_BATCH_MAP_REDUCE=false
# Stage budgets: leave unset to get model-aware defaults
# (non-reasoning: 4000/3500/8000; reasoning models such as Kimi: 16000/16000/24000).
# LLM_NOTES_SEGMENT_MAX_TOKENS=4000
# LLM_NOTES_REDUCE_MAX_TOKENS=3500
# LLM_NOTES_FINAL_MAX_TOKENS=8000
LLM_NOTES_LENGTH_RETRY_ENABLED=true
LLM_NOTES_LENGTH_RETRY_TOKEN_MULTIPLIER=1.5
# Upper bound for the single larger-budget retry
LLM_NOTES_LENGTH_RETRY_MAX_TOKENS=32000
# Used once when the primary model still returns no visible output (finish_reason=length).
# Must be a model id your provider serves. Set to empty to disable.
LLM_NOTES_FALLBACK_MODEL=gpt-4o
LLM_NOTES_FALLBACK_MAX_TOKENS=16000
# Comma-separated model-name prefixes treated as reasoning ("thinking") models
# LLM_REASONING_MODEL_PREFIXES=kimi,o1,o3,o4,deepseek-r1,deepseek-reasoner
# HTTP timeout per LLM call (default 120s; 300s for reasoning models)
# LLM_REQUEST_TIMEOUT_SECONDS=300
# Optional provider-specific reasoning control (JSON), sent only to reasoning models.
# Dropped automatically if the provider rejects it (e.g. always-thinking Kimi K3).
# LLM_REASONING_CONTROL_EXTRA_BODY={"thinking": {"type": "disabled"}}
# Default for the UI "Reasoning effort" dropdown: none|minimal|low|medium|high.
# Non-"none" sends {"reasoning": {"effort": ...}}; silently dropped if the model rejects it.
# LLM_REASONING_EFFORT=low
# Max chat request body size used to budget screenshots (bytes, default 10 MiB)
# LLM_MAX_CHAT_REQUEST_BYTES=10485760

# ── Hugging Face ──────────────────────────────────────────────────────────────
# huggingface_hub is only a transitive dependency of Gradio and is not used.
# bootstrap.py sets these before Gradio imports so the hub stays inert
# (no downloads, no telemetry). Override if needed.
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
DISABLE_TELEMETRY=1
GRADIO_ANALYTICS_ENABLED=False